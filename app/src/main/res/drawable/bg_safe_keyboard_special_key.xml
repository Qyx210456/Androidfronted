<?xml version="1.0" encoding="utf-8"?>
<!-- 安全键盘功能按键背景（删除/大小写/键盘切换，带描边区分普通按键；深色变体由 values-night 颜色令牌自动切换） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/safe_keyboard_special_bg_pressed" />
            <stroke android:width="1dp" android:color="@color/safe_keyboard_special_stroke" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/safe_keyboard_special_bg" />
            <stroke android:width="1dp" android:color="@color/safe_keyboard_special_stroke" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
