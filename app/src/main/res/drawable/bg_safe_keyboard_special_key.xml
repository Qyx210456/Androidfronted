<?xml version="1.0" encoding="utf-8"?>
<!-- 安全键盘功能按键背景（删除/大小写/键盘切换，eg.带描边区分普通按键） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#566EB0" />
            <stroke android:width="1dp" android:color="#6E86C4" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#26324A" />
            <stroke android:width="1dp" android:color="#3D4C73" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
